{
  "name": "authora",
  "version": "1.0.0",
  "private": true,
  "description": "User authentication and JWT internship project",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1",
    "demo": "node src/demo.js",
    "test:mongo": "node --env-file-if-exists=.env scripts/mongo-check.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "supertest": "^7.1.4"
  }
}
